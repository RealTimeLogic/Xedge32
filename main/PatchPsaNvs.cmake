# Keep the provider's ITS format/validation, changing only the NVS partition.
# Compile a checked build copy; never modify the installed ESP-IDF sources.
if(CONFIG_XEDGE_PSA)
    idf_component_get_property(psa_mbedtls_dir mbedtls COMPONENT_DIR)
    set(original "${psa_mbedtls_dir}/port/psa_crypto_storage/esp_psa_its.c")
    file(READ "${original}" code)
    string(REGEX MATCHALL "nvs_open\\(PSA_ITS_NVS_NAMESPACE," calls "${code}")
    list(LENGTH calls count)
    if(NOT count EQUAL 4)
        message(FATAL_ERROR "PSA ITS changed; review PatchPsaNvs.cmake")
    endif()
    string(REPLACE "nvs_open(PSA_ITS_NVS_NAMESPACE,"
        "nvs_open_from_partition(\"psa\", PSA_ITS_NVS_NAMESPACE," code "${code}")
    if(code MATCHES "nvs_open\\(")
        message(FATAL_ERROR "PSA ITS still opens default NVS; review PatchPsaNvs.cmake")
    endif()
    get_target_property(sources tfpsacrypto SOURCES)
    list(FIND sources "${original}" at)
    if(at LESS 0)
        message(FATAL_ERROR "PSA ITS build changed; review PatchPsaNvs.cmake")
    endif()
    set(patched "${CMAKE_CURRENT_BINARY_DIR}/esp_psa_its.c")
    file(WRITE "${patched}" "${code}")
    list(REMOVE_ITEM sources "${original}")
    set_property(TARGET tfpsacrypto PROPERTY SOURCES "${sources}")
    target_sources(tfpsacrypto PRIVATE "${patched}")
endif()
